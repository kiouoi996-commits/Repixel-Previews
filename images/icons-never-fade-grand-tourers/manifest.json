  "reference": {
    "name": "user-supplied-3-screen-interface",
    "width": 1448,
    "height": 1086,
    "unit": "px",
    "estimates": true,
    "note": "Regions measured on raster screenshot, not recovered from original layout; values are approximate."
  },
  "production": {
    "status": "reconstruction",
    "source": "visually reconstructed from supplied screenshot using separately masked regions of a model-generated reference sheet",
    "originals_available": false,
    "generative_individual_assets": false,
    "source_detail_note": "Generator returned a combined draft twice; assets extracted from a draft, processed as separate files. Do not describe as authentic stock/original photographs. Upscaling 3x uses interpolation."
  },
  "backgrounds": {
    "canvas": {
      "type": "radial-gradient",
      "css": "radial-gradient(ellipse at 47% 4%, #EEF0F1 0%, #DEE2E6 56%, #C4CAD1 100%)"
    },
    "home_card": {
      "color": "#F4F4F3"
    },
    "timeline_card": {
      "color": "#FDFDFD"
    },
    "home_blue_accent": {
      "type": "svg_css_geometry",
      "gradient": "linear-gradient(157deg, #7593B2 0%, #88A5C2 100%)",
      "geometry": "Custom curved clipping path from x≈344 at y=66, bowing left to x≈287 around y=360, covering upper right; placed below transparent hero"
    },
    "auction": {
      "css": "radial-gradient(ellipse at 53% 44%, #263038 0%, #171E25 55%, #101820 100%)"
    },
    "auction_cta": {
      "css": "linear-gradient(90deg,#97B0CB 0%,#86A2C0 100%)"
    },
    "collection_cards": {
      "porsche": "#BCC5CF",
      "jaguar": "#C7D1DE",
      "alfa": "#EBE6E0"
    }
  },
  "effects": {
    "main_card_radius_px": 36,
    "main_card_shadow": "0 28px 52px rgba(22,30,40,.17)",
    "collection_card_radius_px": 16,
    "circle_button_border": "1px solid rgba(22,30,40,.5)",
    "image_shadow_note": "Car contact shadows are embedded in raster asset; do not recreate in CSS."
  },
  "ui_only": [
    "Headlines, vehicle names, lot number, dates, estimate, current bid, carousel card captions, timeline year ticks, separator lines, pagination count, screen titles, image bounds and button circles remain live UI.",
    "No Android/iOS status bar icons generated."
  ],
